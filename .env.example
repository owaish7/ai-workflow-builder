# Used by the scripts in scripts/ (setup-db, setup-hasura, seed). Copy to .env.
# Find these in the nhost dashboard: Project -> Settings -> (Overview / Hasura).
NHOST_SUBDOMAIN=your-subdomain
NHOST_REGION=eu-central-1
NHOST_ADMIN_SECRET=your-hasura-admin-secret

# Optional: override the functions base URL if your project differs from the default
# https://<subdomain>.functions.<region>.nhost.run
# NHOST_FUNCTIONS_URL=

# Optional: demo user emails for seed.mjs (defaults shown)
# SEED_A_OWNER=a.owner@example.com
# SEED_A_EDITOR=a.editor@example.com
# SEED_A_VIEWER=a.viewer@example.com
# SEED_B_OWNER=b.owner@example.com
